# Copy to .env.local. FAKE_API=1 needs no provider credentials.
FAKE_API=1
# New source-confirmation flow; leave off until backend and screens are complete.
PROFILE_ENRICHMENT_ENABLED=0
# While B builds the real parts: use in-memory search and/or canned AI inside the real routes
# FAKES=search,ai

# Auth.js + GitHub OAuth app (callback: <url>/api/auth/callback/github)
AUTH_SECRET=
AUTH_GITHUB_ID=
AUTH_GITHUB_SECRET=
# Google OAuth web client, used only when profile enrichment is enabled.
# Callback: <url>/api/auth/callback/google. Scopes: openid profile (no email).
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# Scheduled cleanup of expired private enrichment input (/api/cron/enrichment-cleanup).
# A random string of at least 16 characters; Vercel sends it as "Authorization: Bearer <value>".
# Unset, the endpoint refuses every request.
CRON_SECRET=

# Neon
DATABASE_URL=

# Elastic Cloud
ELASTICSEARCH_URL=
ELASTICSEARCH_API_KEY=

# OpenAI
OPENAI_API_KEY=

# Dash0 (OTLP over HTTP)
OTEL_EXPORTER_OTLP_ENDPOINT=
OTEL_EXPORTER_OTLP_HEADERS=Authorization=Bearer <dash0-token>,Dash0-Dataset=default
