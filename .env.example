# Copy to .env.local. FAKE_API=1 needs no provider credentials.
FAKE_API=1
# New source-confirmation flow; leave off until backend and screens are complete.
PROFILE_ENRICHMENT_ENABLED=0
# While B builds the real parts: use in-memory search and/or canned AI inside the real routes
# FAKES=search,ai

# Auth.js + GitHub OAuth app (callback: <url>/api/auth/callback/github)
AUTH_SECRET=
AUTH_GITHUB_ID=
AUTH_GITHUB_SECRET=

# Neon
DATABASE_URL=

# Elastic Cloud
ELASTICSEARCH_URL=
ELASTICSEARCH_API_KEY=

# OpenAI
OPENAI_API_KEY=

# Dash0 (OTLP over HTTP)
OTEL_EXPORTER_OTLP_ENDPOINT=
OTEL_EXPORTER_OTLP_HEADERS=Authorization=Bearer <dash0-token>,Dash0-Dataset=default
