{
  "items": [
    {
      "kind": "Dash0SignalToMetrics",
      "metadata": {
        "name": "convo.ai.tokens.input",
        "labels": {
          "dash0.com/origin": "convo-convo-ai-tokens-input"
        }
      },
      "spec": {
        "enabled": true,
        "display": {
          "name": "convo.ai.tokens.input"
        },
        "match": {
          "signal": "spans",
          "filters": [
            {
              "key": "service.name",
              "operator": "is",
              "value": "convo"
            },
            {
              "key": "deployment.environment.name",
              "operator": "is",
              "value": "production"
            },
            {
              "key": "gen_ai.usage.input_tokens",
              "operator": "is_set"
            }
          ]
        },
        "output": {
          "name": "convo.ai.tokens.input",
          "interval": "60s",
          "keepResourceAttributes": [
            {
              "operator": "is",
              "value": "service.name"
            },
            {
              "operator": "is",
              "value": "deployment.environment.name"
            }
          ],
          "type": "sum",
          "value": "attributes[\"gen_ai.usage.input_tokens\"]",
          "monotonic": true
        }
      }
    },
