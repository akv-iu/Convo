{
  "name": "convo",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.18.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "es:rebuild": "tsx --env-file-if-exists=.env.local es/rebuild.ts",
    "seed": "tsx --env-file-if-exists=.env.local scripts/seed.ts",
    "try-search": "tsx --env-file-if-exists=.env.local scripts/try-search.ts"
  },
  "dependencies": {
    "@elastic/elasticsearch": "^9.5.1",
    "@neondatabase/serverless": "^1.2.0",
    "@opentelemetry/api": "^1.9.1",
    "@vercel/otel": "^2.2.1",
    "drizzle-orm": "^0.45.4",
    "mammoth": "1.13.0",
    "next": "16.4.5",
    "next-auth": "^5.0.0-beta.32",
    "openai": "^7.51.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "unpdf": "1.9.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@playwright/test": "^1.64.1",
    "@tailwindcss/turbopack": "^4",
    "@types/node": "^22.20.5",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitest/coverage-v8": "^5.1.0",
    "drizzle-kit": "^0.31.11",
    "eslint": "^9",
    "eslint-config-next": "16.4.5",
    "tailwindcss": "^4",
    "tsx": "^4.23.15",
    "typescript": "^5",
    "vitest": "^5.1.0"
  }
}
